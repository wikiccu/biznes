# Set API variables in the process environment; the Go application does not load env files.
BIZNES_HTTP_PORT=8080
BIZNES_LOG_LEVEL=info
BIZNES_HTTP_READ_HEADER_TIMEOUT=5s
BIZNES_HTTP_READ_TIMEOUT=15s
BIZNES_HTTP_WRITE_TIMEOUT=15s
BIZNES_HTTP_IDLE_TIMEOUT=60s
BIZNES_HTTP_SHUTDOWN_TIMEOUT=10s

# Local PostgreSQL settings for Compose, which reads .env automatically.
# Set a local development password before starting PostgreSQL.
BIZNES_POSTGRES_PORT=5432
BIZNES_POSTGRES_DB=biznes
BIZNES_POSTGRES_USER=biznes
BIZNES_POSTGRES_PASSWORD=
